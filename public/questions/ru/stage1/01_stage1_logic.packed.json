[{"type":"question","id":"01_stage1_logic_001","q":"Если все программисты любят логику, а Петя — программист, то Петя:","o":["A) Любит логику","B) Не любит","C) Неизвестно","D) Это не связано"],"k":"Vg=="},{"type":"question","id":"01_stage1_logic_002","q":"Если все роботы — машины, но не все машины — роботы, то верно ли, что все машины — роботы?","o":["A) Да","B) Нет","C) Иногда","D) Невозможно определить"],"k":"Vw=="},{"type":"question","id":"01_stage1_logic_003","q":"Последовательность: 3, 6, 12, 24, ?","o":["A) 36","B) 42","C) 48","D) 30"],"k":"VA=="},{"type":"question","id":"01_stage1_logic_004","q":"Если все студенты изучают информатику, а Анна — студентка, то Анна:","o":["A) Изучает информатику","B) Не изучает","C) Неизвестно","D) Это не связано"],"k":"Vg=="},{"type":"question","id":"01_stage1_logic_005","q":"Если все квадраты — прямоугольники, но не все прямоугольники — квадраты, верно ли, что все прямоугольники — квадраты?","o":["A) Да","B) Нет","C) Иногда","D) Невозможно определить"],"k":"Vw=="},{"type":"question","id":"01_stage1_logic_006","q":"Последовательность: 2, 5, 10, 17, 26, ?","o":["A) 35","B) 40","C) 37","D) 39"],"k":"VA=="},{"type":"question","id":"01_stage1_logic_007","q":"A) 8","o":["B) 9","C) 10","D) 11"],"k":"Vg=="},{"type":"question","id":"01_stage1_logic_008","q":"Если все кошки — животные, а Барсик — кошка, то Барсик:","o":["A) Животное","B) Не животное","C) Неизвестно","D) Это не связано"],"k":"Vg=="},{"type":"question","id":"01_stage1_logic_009","q":"Если к числу 4 каждый раз прибавлять 2, какое число получится после 4, 6, 8, 10, ?","o":["A) 11","B) 12","C) 14","D) 16"],"k":"Vw=="}]